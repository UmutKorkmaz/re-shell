{
  "root": "dist",
  "budgets": [
    { "name": "initial JS: app entry", "match": "assets/index-*.js", "maxGzipBytes": 38912 },
    { "name": "initial JS: entry + vendor chunks loaded on first paint", "match": "assets/{index,vendor-react,vendor-query,vendor-radix,vendor-zod}-*.js", "maxGzipBytes": 141312 },
    { "name": "vendor-react", "match": "assets/vendor-react-*.js", "maxGzipBytes": 51200 },
    { "name": "vendor-query", "match": "assets/vendor-query-*.js", "maxGzipBytes": 13312 },
    { "name": "vendor-radix", "match": "assets/vendor-radix-*.js", "maxGzipBytes": 17408 },
    { "name": "vendor-zod", "match": "assets/vendor-zod-*.js", "maxGzipBytes": 22528 },
    { "name": "React Flow (Workspace Graph only)", "match": "assets/vendor-xyflow-*.js", "maxGzipBytes": 65536 },
    { "name": "each screen chunk", "match": "assets/*Screen-*.js", "each": true, "maxGzipBytes": 6144 },
    { "name": "every JS chunk", "match": "assets/*.js", "each": true, "maxGzipBytes": 65536 },
    { "name": "all JS", "match": "assets/*.js", "maxGzipBytes": 256000 },
    { "name": "entry stylesheet", "match": "assets/index-*.css", "maxGzipBytes": 12288 },
    { "name": "all CSS", "match": "assets/*.css", "maxGzipBytes": 16384 },
    { "name": "each woff2 font", "match": "assets/*.woff2", "each": true, "maxGzipBytes": 27648 },
    { "name": "all woff2 fonts", "match": "assets/*.woff2", "maxGzipBytes": 194560 },
    { "name": "index.html", "match": "index.html", "maxGzipBytes": 2048 }
  ]
}
