{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://re-shell.dev/schemas/workspace-v2.schema.json",
  "title": "Re-Shell Workspace Configuration v2.0",
  "description": "Comprehensive workspace configuration for multi-language, multi-framework microservices projects",
  "type": "object",
  "required": ["name", "version", "services"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Workspace name",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 63
    },
    "version": {
      "type": "string",
      "description": "Configuration version",
      "pattern": "^2\\.0\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "description": "Workspace description"
    },
    "metadata": {
      "type": "object",
      "description": "Workspace metadata",
      "properties": {
        "author": { "type": "string" },
        "license": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tags": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "variables": {
      "type": "object",
      "description": "Global environment variables",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    },
    "config": {
      "type": "object",
      "description": "Global configuration settings",
      "properties": {
        "defaultRegion": {
          "type": "string",
          "description": "Default cloud region"
        },
        "defaultRuntime": {
          "type": "string",
          "description": "Default runtime environment"
        },
        "network": {
          "type": "object",
          "description": "Network configuration",
          "properties": {
            "vpcCidr": { "type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]+$" },
            "subnetCidr": { "type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]+$" },
            "enableServiceMesh": { "type": "boolean" }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "description": "Service definitions",
      "additionalProperties": {
        "$ref": "#/definitions/service"
      }
    },
    "dependencies": {
      "type": "object",
      "description": "External dependencies",
      "properties": {
        "databases": {
          "type": "array",
          "items": { "$ref": "#/definitions/database" }
        },
        "caches": {
          "type": "array",
          "items": { "$ref": "#/definitions/cache" }
        },
        "queues": {
          "type": "array",
          "items": { "$ref": "#/definitions/queue" }
        },
        "storage": {
          "type": "array",
          "items": { "$ref": "#/definitions/storage" }
        }
      }
    },
    "deployment": {
      "$ref": "#/definitions/deployment"
    },
    "monitoring": {
      "$ref": "#/definitions/monitoring"
    },
    "kubernetes": {
      "$ref": "#/definitions/kubernetesConfig"
    },
    "tasks": {
      "type": "object",
      "description": "Task graph for the dependency-aware task runner (`re-shell run <task>`). Maps a task name to its dependencies. A dependency is either a sibling task in the same package (e.g. \"build\") or, with a \"^\" prefix, the same task on this package's upstream workspace dependencies (e.g. \"^build\"). When omitted, sensible defaults apply (build -> ^build; test -> build).",
      "additionalProperties": {
        "$ref": "#/definitions/taskConfig"
      }
    }
  },
  "definitions": {
    "intOrString": {
      "description": "A Kubernetes int-or-string value (e.g. maxSurge: 1 or maxSurge: \"25%\").",
      "oneOf": [{ "type": "integer" }, { "type": "string" }],
      "x-kubernetes-int-or-string": true
    },
    "k8sProbe": {
      "type": "object",
      "description": "A liveness/readiness/startup probe. An httpGet probe is generated when a health path is known (this block's `path`, `kubernetes.probes.path`, or the service `healthCheck.path`); otherwise a tcpSocket probe on the container port.",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "description": "HTTP path to probe (httpGet)." },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "kubernetesConfig": {
      "type": "object",
      "description": "Kubernetes deployment settings used by `re-shell k8s generate`, `k8s helm generate`, `k8s gitops generate`, `k8s crd|operator|mesh`. Set at the workspace level for defaults and per service to override. Resolution order: built-in defaults < workspace `deployment` < workspace `kubernetes` < service `resources`/`healthCheck`/`scaling` < service `kubernetes`.",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": { "type": "string", "description": "Registry prefix (e.g. ghcr.io/acme); prepended to the repository." },
            "repository": { "type": "string", "description": "Image repository; defaults to the service name." },
            "tag": { "type": "string", "description": "Image tag; defaults to \"latest\" (CI should override)." },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "description": "Kubernetes-shaped resources; overrides the service `resources` block.",
          "properties": {
            "requests": { "type": "object", "additionalProperties": { "type": "string" } },
            "limits": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "securityContext": {
          "type": "object",
          "description": "Pod and container hardening. Defaults satisfy the Pod Security Standards `restricted` profile.",
          "properties": {
            "runAsNonRoot": { "type": "boolean" },
            "runAsUser": { "type": "integer", "minimum": 0 },
            "runAsGroup": { "type": "integer", "minimum": 0 },
            "fsGroup": { "type": "integer", "minimum": 0 },
            "readOnlyRootFilesystem": { "type": "boolean" },
            "allowPrivilegeEscalation": { "type": "boolean" },
            "capabilities": {
              "type": "object",
              "properties": {
                "drop": { "type": "array", "items": { "type": "string" } },
                "add": { "type": "array", "items": { "type": "string" } }
              }
            },
            "seccompProfile": { "type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"] },
            "writablePaths": {
              "type": "array",
              "description": "Absolute paths mounted as emptyDir volumes so the app can write while the root filesystem is read-only. Defaults to [\"/tmp\"].",
              "items": { "type": "string", "pattern": "^/" }
            }
          }
        },
        "automountServiceAccountToken": { "type": "boolean" },
        "probes": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "description": "Health path used by every probe that does not set its own." },
            "liveness": { "$ref": "#/definitions/k8sProbe" },
            "readiness": { "$ref": "#/definitions/k8sProbe" },
            "startup": { "$ref": "#/definitions/k8sProbe" }
          }
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
            "maxSurge": { "$ref": "#/definitions/intOrString" },
            "maxUnavailable": { "$ref": "#/definitions/intOrString" }
          }
        },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0, "description": "ReplicaSets kept for `kubectl rollout undo` / `re-shell k8s rollback`." },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "minReadySeconds": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "$ref": "#/definitions/intOrString" },
            "maxUnavailable": { "$ref": "#/definitions/intOrString" }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "cpuUtilization": { "type": "integer", "minimum": 1, "maximum": 100 },
            "memoryUtilization": { "type": "integer", "minimum": 1, "maximum": 100 },
            "customMetric": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string" },
                "averageValue": { "type": "string" }
              }
            }
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "path": { "type": "string" },
            "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
            "className": { "type": "string" },
            "clusterIssuer": { "type": "string", "description": "cert-manager ClusterIssuer used for TLS automation." },
            "tls": { "type": "boolean" }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "allowFromNamespaces": {
              "type": "array",
              "description": "Extra namespaces allowed to reach the service in addition to its own namespace. Defaults to [\"ingress-nginx\"] for nginx-class ingress.",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "taskConfig": {
      "type": "object",
      "description": "Dependencies and cache hints for a single task in the task graph.",
      "properties": {
        "dependsOn": {
          "type": "array",
          "description": "Tasks that must complete before this task. A bare name (e.g. \"build\") is a sibling task in the same package; a \"^\"-prefixed name (e.g. \"^build\") is the same task on each upstream workspace dependency.",
          "items": {
            "type": "string",
            "pattern": "^\\^?[a-zA-Z0-9][a-zA-Z0-9:_-]*$"
          }
        },
        "inputs": {
          "type": "array",
          "description": "Globs (relative to the package directory) defining the file set hashed into this task's content-addressed cache key. When omitted, the whole package directory (minus declared outputs, node_modules, and dist) is hashed.",
          "items": { "type": "string" }
        },
        "outputs": {
          "type": "array",
          "description": "Globs (relative to the package directory) defining the artifacts captured on a cache miss and restored on a cache hit by the build cache.",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["name", "language", "framework"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["frontend", "backend", "worker", "function"]
        },
        "language": {
          "type": "string",
          "enum": [
            "typescript", "javascript",
            "python", "go", "rust",
            "java", "kotlin", "scala",
            "csharp", "fsharp",
            "php", "ruby",
            "elixir", "clojure",
            "haskell", "f#",
            "swift", "dart",
            "crystal", "zig", "nim", "v",
            "deno", "bun"
          ]
        },
        "framework": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string" },
                "version": { "type": "string" },
                "config": { "type": "object" }
              }
            }
          ]
        },
        "path": {
          "type": "string",
          "description": "Relative path to service code"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "env": {
          "type": "object",
          "description": "Service-specific environment variables",
          "additionalProperties": { "type": "string" }
        },
        "dependsOn": {
          "type": "array",
          "description": "Names of other services in this workspace that this service depends on at runtime. Used by `re-shell dev --cluster` to scope affected re-syncs: editing a service re-syncs it plus every service that (transitively) dependsOn it.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          }
        },
        "dependencies": {
          "type": "object",
          "description": "Service dependencies (language packages)",
          "properties": {
            "production": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "development": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "scripts": {
          "type": "object",
          "properties": {
            "build": { "type": "string" },
            "start": { "type": "string" },
            "dev": { "type": "string" },
            "test": { "type": "string" },
            "lint": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "build": {
          "$ref": "#/definitions/buildConfig"
        },
        "scaling": {
          "$ref": "#/definitions/scalingConfig"
        },
        "resources": {
          "$ref": "#/definitions/resourceConfig"
        },
        "healthCheck": {
          "$ref": "#/definitions/healthCheck"
        },
        "kubernetes": {
          "$ref": "#/definitions/kubernetesConfig"
        },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/route" }
        },
        "middleware": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "config": { "type": "object" }
                }
              }
            ]
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "authentication", "authorization", "database", "caching",
              "logging", "monitoring", "testing", "documentation",
              "security", "validation", "rate-limiting", "cors",
              "compression", "session-management", "file-upload",
              "email", "websockets", "graphql", "rest-api"
            ]
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["postgresql", "mysql", "mongodb", "redis", "dynamodb", "cassandra"]
        },
        "version": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "database": { "type": "string" },
        "ssl": { "type": "boolean" },
        "poolSize": { "type": "integer" },
        "connectionTimeout": { "type": "integer" }
      }
    },
    "cache": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["redis", "memcached", "dynamodb"]
        },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "ttl": { "type": "integer" },
        "maxMemory": { "type": "string" }
      }
    },
    "queue": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["sqs", "rabbitmq", "kafka", "redis"]
        },
        "maxRetries": { "type": "integer" },
        "timeout": { "type": "integer" }
      }
    },
    "storage": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["s3", "gcs", "azure-blob", "local"]
        },
        "bucket": { "type": "string" },
        "region": { "type": "string" }
      }
    },
    "buildConfig": {
      "type": "object",
      "properties": {
        "output": { "type": "string" },
        "dockerfile": { "type": "string" },
        "context": { "type": "string" },
        "args": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "cacheFrom": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scalingConfig": {
      "type": "object",
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "target": {
          "type": "number",
          "minimum": 1
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["cpu", "memory", "requests", "custom"]
              },
              "value": { "type": "number" },
              "name": {
                "type": "string",
                "description": "Metric name for type \"custom\" (and \"requests\"); surfaced as a Pods metric on the generated HorizontalPodAutoscaler."
              }
            }
          }
        }
      }
    },
    "resourceConfig": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "object",
          "properties": {
            "request": { "type": "string", "pattern": "^[0-9]+m$" },
            "limit": { "type": "string", "pattern": "^[0-9]+m$" }
          }
        },
        "memory": {
          "type": "object",
          "properties": {
            "request": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" },
            "limit": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
          }
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "interval": { "type": "integer", "minimum": 1 },
        "timeout": { "type": "integer", "minimum": 1 },
        "retries": { "type": "integer", "minimum": 0 }
      }
    },
    "route": {
      "type": "object",
      "required": ["path", "target"],
      "properties": {
        "path": { "type": "string" },
        "target": { "type": "string" },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"]
        },
        "middleware": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["kubernetes", "docker-compose", "aws", "gcp", "azure"]
        },
        "strategy": {
          "type": "string",
          "enum": ["rolling", "blue-green", "canary"]
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" },
              "secret": { "type": "boolean" }
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["cpu", "memory", "disk", "network", "requests", "errors", "latency"]
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "metric", "threshold"],
            "properties": {
              "name": { "type": "string" },
              "metric": { "type": "string" },
              "threshold": { "type": "number" },
              "comparison": {
                "enum": ["greater-than", "less-than", "equals"]
              },
              "severity": {
                "enum": ["info", "warning", "critical"]
              }
            }
          }
        }
      }
    }
  }
}
