{
  "name": "re-shell",
  "displayName": "Re-Shell",
  "description": "Manage re-shell projects from inside VS Code: browse apps/packages, run commands, scaffold from templates, and monitor workspace health.",
  "version": "0.3.0",
  "license": "MIT",
  "publisher": "umutkorkmaz",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/UmutKorkmaz/re-shell"
  },
  "homepage": "https://github.com/UmutKorkmaz/re-shell",
  "bugs": {
    "url": "https://github.com/UmutKorkmaz/re-shell/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:reShell.projects",
    "onView:reShell.commands",
    "onView:reShell.templates",
    "workspaceContains:**/workspace.yaml",
    "workspaceContains:**/workspace.yml",
    "workspaceContains:**/pnpm-workspace.yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reShell",
          "title": "Re-Shell",
          "icon": "media/re-shell.svg"
        }
      ]
    },
    "views": {
      "reShell": [
        {
          "id": "reShell.projects",
          "name": "Projects",
          "contextualTitle": "Re-Shell Projects"
        },
        {
          "id": "reShell.commands",
          "name": "Commands",
          "contextualTitle": "Re-Shell Commands"
        },
        {
          "id": "reShell.templates",
          "name": "Templates",
          "contextualTitle": "Re-Shell Templates"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reShell.projects",
        "contents": "No re-shell workspace detected in this folder.\n[Create Project](command:reShell.createProject)\n[Refresh](command:reShell.refresh)\nTo learn more [read the docs](https://github.com/UmutKorkmaz/re-shell).",
        "when": "reShell.workspaceDetected === false"
      },
      {
        "view": "reShell.projects",
        "contents": "No apps or packages found in this workspace.\n[Create Project](command:reShell.createProject)\n[Refresh](command:reShell.refresh)",
        "when": "reShell.workspaceDetected && reShell.hasProjects === false"
      },
      {
        "view": "reShell.templates",
        "contents": "No templates loaded.\n[Refresh](command:reShell.refresh)\nVerify the Re-Shell CLI is installed (`npm i -g re-shell`).",
        "when": "reShell.templatesLoaded === false"
      }
    ],
    "commands": [
      {
        "command": "reShell.refresh",
        "title": "Re-Shell: Refresh",
        "category": "Re-Shell",
        "icon": "$(refresh)"
      },
      {
        "command": "reShell.runDoctor",
        "title": "Re-Shell: Run Doctor",
        "category": "Re-Shell",
        "icon": "$(stethoscope)"
      },
      {
        "command": "reShell.runCommand",
        "title": "Re-Shell: Run Command",
        "category": "Re-Shell",
        "icon": "$(play)"
      },
      {
        "command": "reShell.buildCommand",
        "title": "Re-Shell: Build Command",
        "category": "Re-Shell",
        "icon": "$(tools)"
      },
      {
        "command": "reShell.runViaHub",
        "title": "Re-Shell: Run via Hub",
        "category": "Re-Shell",
        "icon": "$(cloud)"
      },
      {
        "command": "reShell.openTerminal",
        "title": "Re-Shell: Open Terminal",
        "category": "Re-Shell",
        "icon": "$(terminal)"
      },
      {
        "command": "reShell.createProject",
        "title": "Re-Shell: Create Project",
        "category": "Re-Shell",
        "icon": "$(add)"
      },
      {
        "command": "reShell.createProjectFromTemplate",
        "title": "Re-Shell: Create Project from Template",
        "category": "Re-Shell",
        "icon": "$(add)"
      },
      {
        "command": "reShell.runCommandFromTree",
        "title": "Re-Shell: Run Command",
        "category": "Re-Shell",
        "icon": "$(play)"
      },
      {
        "command": "reShell.copyCommand",
        "title": "Re-Shell: Copy Command",
        "category": "Re-Shell",
        "icon": "$(copy)"
      },
      {
        "command": "reShell.buildProject",
        "title": "Re-Shell: Build",
        "category": "Re-Shell",
        "icon": "$(package)"
      },
      {
        "command": "reShell.serveProject",
        "title": "Re-Shell: Serve",
        "category": "Re-Shell",
        "icon": "$(server)"
      },
      {
        "command": "reShell.testProject",
        "title": "Re-Shell: Test",
        "category": "Re-Shell",
        "icon": "$(beaker)"
      },
      {
        "command": "reShell.openProjectTerminal",
        "title": "Re-Shell: Open Terminal",
        "category": "Re-Shell",
        "icon": "$(terminal)"
      },
      {
        "command": "reShell.revealProject",
        "title": "Re-Shell: Reveal in Explorer",
        "category": "Re-Shell",
        "icon": "$(folder)"
      },
      {
        "command": "reShell.showOutput",
        "title": "Re-Shell: Show Output",
        "category": "Re-Shell"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reShell.refresh",
          "when": "view == reShell.projects",
          "group": "navigation"
        },
        {
          "command": "reShell.createProject",
          "when": "view == reShell.projects",
          "group": "navigation"
        },
        {
          "command": "reShell.refresh",
          "when": "view == reShell.commands",
          "group": "navigation"
        },
        {
          "command": "reShell.runCommand",
          "when": "view == reShell.commands",
          "group": "navigation"
        },
        {
          "command": "reShell.refresh",
          "when": "view == reShell.templates",
          "group": "navigation"
        },
        {
          "command": "reShell.runViaHub",
          "when": "view == reShell.commands",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "reShell.buildProject",
          "when": "view == reShell.projects && viewItem == reShellProject",
          "group": "reShell.project@1"
        },
        {
          "command": "reShell.serveProject",
          "when": "view == reShell.projects && viewItem == reShellProject",
          "group": "reShell.project@2"
        },
        {
          "command": "reShell.testProject",
          "when": "view == reShell.projects && viewItem == reShellProject",
          "group": "reShell.project@3"
        },
        {
          "command": "reShell.openProjectTerminal",
          "when": "view == reShell.projects && viewItem == reShellProject",
          "group": "reShell.project@4"
        },
        {
          "command": "reShell.revealProject",
          "when": "view == reShell.projects && viewItem == reShellProject",
          "group": "reShell.project@5"
        },
        {
          "command": "reShell.buildProject",
          "when": "view == reShell.projects && viewItem == reShellProject",
          "group": "inline"
        },
        {
          "command": "reShell.runCommandFromTree",
          "when": "view == reShell.commands && viewItem =~ /^reShellCommand/",
          "group": "reShell.command@1"
        },
        {
          "command": "reShell.copyCommand",
          "when": "view == reShell.commands && viewItem =~ /^reShellCommand/",
          "group": "reShell.command@2"
        },
        {
          "command": "reShell.runViaHub",
          "when": "view == reShell.commands && viewItem == reShellCommandHub",
          "group": "reShell.command@3"
        },
        {
          "command": "reShell.runViaHub",
          "when": "view == reShell.commands && viewItem == reShellCommandHub",
          "group": "inline"
        },
        {
          "command": "reShell.runCommandFromTree",
          "when": "view == reShell.commands && viewItem =~ /^reShellCommand/",
          "group": "inline"
        },
        {
          "command": "reShell.createProjectFromTemplate",
          "when": "view == reShell.templates && viewItem == reShellTemplate",
          "group": "reShell.template@1"
        },
        {
          "command": "reShell.createProjectFromTemplate",
          "when": "view == reShell.templates && viewItem == reShellTemplate",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "reShell.runCommandFromTree",
          "when": "false"
        },
        {
          "command": "reShell.copyCommand",
          "when": "false"
        },
        {
          "command": "reShell.buildProject",
          "when": "false"
        },
        {
          "command": "reShell.serveProject",
          "when": "false"
        },
        {
          "command": "reShell.testProject",
          "when": "false"
        },
        {
          "command": "reShell.openProjectTerminal",
          "when": "false"
        },
        {
          "command": "reShell.revealProject",
          "when": "false"
        },
        {
          "command": "reShell.createProjectFromTemplate",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Re-Shell",
      "properties": {
        "reShell.cliBin": {
          "type": "string",
          "default": "re-shell",
          "scope": "machine",
          "markdownDescription": "Path or name of the Re-Shell CLI used to fetch workspace data and run commands. An absolute path to the CLI's JavaScript entry (for example `packages/cli/dist/index.js` in a checkout) is run with Node. When left at the default, the `RE_SHELL_CLI_BIN` environment variable is used if set."
        },
        "reShell.hub.url": {
          "type": "string",
          "default": "http://127.0.0.1:3334",
          "scope": "machine",
          "markdownDescription": "Base URL of the local Re-Shell hub server (printed as `Hub:` by `re-shell ui`). When left at the default, the `RE_SHELL_UI_HUB_URL` environment variable is used if set."
        },
        "reShell.hub.token": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Session token for the local hub, sent as the `x-re-shell-ui-hub-token` header (printed as `Hub token:` by `re-shell ui`). Falls back to the `RE_SHELL_UI_HUB_TOKEN` environment variable when empty. Stored in user settings only; never put a token in workspace settings."
        },
        "reShell.hub.timeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "scope": "machine",
          "description": "Maximum time in milliseconds a command run through the hub may take before the request is aborted."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host-tests": "node scripts/build-host-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:host": "pnpm run build && pnpm run build:host-tests && node dist-test/host/run.js",
    "test:watch": "vitest",
    "package": "node scripts/build.mjs --minify && vsce package --no-dependencies && node scripts/verify-vsix.mjs",
    "clean": "rm -rf dist dist-test .vscode-test *.vsix"
  },
  "devDependencies": {
    "@re-shell/contracts": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.21.5",
    "mocha": "^10.8.2",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "zod": "^4.4.3"
  },
  "icon": "media/icon.png",
  "keywords": [
    "re-shell",
    "microfrontend",
    "monorepo",
    "cli",
    "hub"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Re-Shell runs the re-shell CLI against the open folder, so it is only available in trusted workspaces."
    }
  }
}
