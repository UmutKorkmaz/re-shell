# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# Signing keys (REQUIRED). After `docker compose build`, generate with:
#   docker run --rm re-shell/control-plane:local gen-key --raw
# then paste the compact JSON on one line, single-quoted:
CONTROL_PLANE_JWT_KEYS='{"activeKid":"key-1","keys":{"key-1":"<base64url secret, at least 32 bytes>"}}'

# Users allowed to create tenants (comma separated user ids).
CONTROL_PLANE_PLATFORM_ADMINS=alice

# Browser origins allowed to call the API (exact origins, never "*").
CONTROL_PLANE_CORS_ORIGINS=

# Collaboration (docs/control-plane.md section 14). WebRTC STUN/TURN servers handed to session
# participants; empty = host candidates only. TURN entries need credentials, and every participant
# can read them: use short-lived credentials.
# CONTROL_PLANE_ICE_SERVERS='[{"urls":"stun:stun.example.org:3478"}]'
# CONTROL_PLANE_MAX_ACTIVE_SESSIONS=50

# Worker: Compose --profile development is trusted process mode only.
# For isolated host orchestration see docs/job-isolation.md.
CONTROL_PLANE_TENANT=acme
CONTROL_PLANE_WORKER_TOKEN=<issued with: issue-token --worker --worker-id w1 --tenant acme --raw>
# CONTROL_PLANE_WORKSPACES_DIR=./workspaces

# Optional bearer SSO. Mount only trusted PUBLIC JWKS into the server container
# via a Compose override; see docs/OIDC.md. Never use a bearer-controlled key URL.
# CONTROL_PLANE_OIDC_ISSUER=https://idp.example.org
# CONTROL_PLANE_OIDC_AUDIENCE=re-shell-api
# CONTROL_PLANE_OIDC_JWKS_FILE=/run/config/oidc-public-jwks.json

# Isolated staging: export these for the HOST orchestrator, not Compose.
# CONTROL_PLANE_WORKER_MODE=docker
# CONTROL_PLANE_WORKER_ID=staging-1
# CONTROL_PLANE_DOCKER_HOST=unix:///absolute/path/to/dedicated/docker.sock
# CONTROL_PLANE_JOB_IMAGE=sha256:<64 hex image id from docker image inspect>
# CONTROL_PLANE_WORKSPACE_ROOT=/absolute/path/to/operator-owned/workspaces
# CONTROL_PLANE_URL=http://127.0.0.1:8787
# CONTROL_PLANE_JOB_CPUS=1
# CONTROL_PLANE_JOB_MEMORY_MB=512
# CONTROL_PLANE_JOB_PIDS=128
# CONTROL_PLANE_JOB_UID=1000
# CONTROL_PLANE_JOB_GID=1000
# Optional provider logout/revocation endpoints (operator pinned; see docs/OIDC.md).
# CONTROL_PLANE_OIDC_REVOCATION_ENDPOINT=https://idp.example.org/protocol/openid-connect/revoke
# CONTROL_PLANE_OIDC_END_SESSION_ENDPOINT=https://idp.example.org/protocol/openid-connect/logout
