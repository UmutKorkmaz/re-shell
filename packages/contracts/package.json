{
  "name": "@re-shell/contracts",
  "version": "0.3.2",
  "description": "Shared TypeScript contracts for Re-Shell UI and CLI integration.",
  "license": "MIT",
  "author": "Umut Korkmaz",
  "keywords": [
    "re-shell",
    "contracts",
    "typescript",
    "zod",
    "schemas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UmutKorkmaz/re-shell.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./command-registry": {
      "types": "./dist/command-registry.d.ts",
      "import": "./dist/command-registry.js",
      "require": "./dist/cjs/command-registry.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --quiet"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "homepage": "https://umutkorkmaz.github.io/re-shell/",
  "bugs": {
    "url": "https://github.com/UmutKorkmaz/re-shell/issues"
  }
}
